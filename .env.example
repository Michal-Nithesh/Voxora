# Copy this file to .env and fill in your keys.
# The app works without API keys in Browser + None-translation mode.

PORT=5001
FRONTEND_ORIGIN=http://localhost:5001

# Supabase PostgreSQL persistence. Keep the service-role key server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Local development only. Production rejects anonymous persistence.
ALLOW_ANONYMOUS_PERSISTENCE=true

# Required for OpenAI Whisper transcription and GPT-4o-mini translation
OPENAI_API_KEY=sk-...

# Required for AssemblyAI real-time transcription
ASSEMBLYAI_API_KEY=...

# Google Gemini API key for translation and transcript improvement
GEMINI_API_KEY=...
